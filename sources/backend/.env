# Copia questo file in .env e compilalo con i valori del tuo progetto GCP.
# .env non va mai committato (vedi .gitignore) e non contiene segreti: Sage usa Vertex AI
# via Application Default Credentials, non serve nessuna API key.

# Obbligatorio: il tuo project id GCP (its-ict-<nome>-<cognome>)
SAGE_PROJECT_ID=its-ict-sage-csp26

# Progetto condiviso tra più persone: valorizza il prefisso (its-ict-sage-<nome>-<cognome>) e
# SAGE_PROJECT_ID sarà il progetto condiviso. Lascialo vuoto con un progetto dedicato.
# Database Firestore e dataset BigQuery ne derivano in automatico (vedi sage/config.py:
# SAGE_BQ_DATASET resta il nome base, il prefisso viene aggiunto dal codice).
SAGE_RESOURCE_PREFIX=

# Opzionali: i valori di default vanno bene per il corso
SAGE_REGION=europe-west6
SAGE_FIRESTORE_COLLECTION=chunks
SAGE_TOP_K=5
SAGE_CHAT_MODEL=gemini-2.5-flash
SAGE_EMBEDDING_MODEL=text-embedding-004
SAGE_EMBEDDING_DIMENSION=768
SAGE_BQ_DATASET=sage_analytics
SAGE_BQ_TABLE=question_log
SAGE_CHUNK_MAX_CHARS=1500
